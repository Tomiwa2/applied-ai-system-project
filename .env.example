# PawPal+ Copilot configuration.
# Copy this file to `.env` (or export these in your shell) to enable the real
# Claude API. If ANTHROPIC_API_KEY is unset, the system automatically falls back
# to the deterministic offline "stub" planner — everything still runs.

# Your Anthropic API key. Leave blank to run fully offline on the stub.
ANTHROPIC_API_KEY=

# Which Claude model the agent calls. claude-opus-5 is the project default.
PAWPAL_MODEL=claude-opus-5

# Force a backend regardless of the key: "claude" or "stub".
# Leave blank to auto-detect (real Claude when a key is present, else stub).
PAWPAL_LLM=